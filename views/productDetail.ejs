<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= title %>
  </title>
</head>

<body>
  <a href="/">← Back to Products</a>

  <h1>
    <%= product.productName %>
  </h1>

  <p>Category: <%= product.Category.categoryName %>
  </p>

  <p>Seller: <%= product.User.username %>
  </p>

  <p>Price: <%= formatRp(product.price) %>
  </p>

  <p>Stock: <%= product.stock %>
  </p>

  <p>Product ID: <%= product.id %>
  </p>
  <form action="/orders/cart/add/<%= product.id %>" method="POST">
    <button type="submit">Add to Cart</button>
  </form>
</body>

</html>