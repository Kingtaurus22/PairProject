<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= title %>
  </title>

  <link rel="stylesheet" href="/checkout/checkout.css" />
</head>

<body>

  <div class="page-container">

   

    <header class="navbar">

      <div class="brand">

        <div class="brand-logo">
          V
        </div>

        <div class="brand-info">
          <h1>Vendra</h1>
          <span>Marketplace</span>
        </div>

      </div>


      <div class="navbar-actions">

        <a href="/" class="nav-link">
          Products
        </a>

        <a href="/cart" class="nav-link">
          Cart
        </a>

        <a href="/orders" class="nav-link">
          My Orders
        </a>

        <a href="/profile" class="profile-button">
          <%= username %>
        </a>

        <form action="/logout" method="POST">

          <button type="submit" class="logout-button">
            Logout
          </button>

        </form>

      </div>

    </header>


   

    <main class="checkout-section">

      <div class="section-label">
        VENDRA CHECKOUT
      </div>


      <div class="checkout-header">

        <div>

          <h2>
            Checkout
          </h2>

          <p>
            Review your order and select a payment method.
          </p>

        </div>


        <a href="/cart" class="back-button">
          ← Back to Cart
        </a>

      </div>


      

      <% if (errors) { %>

        <div class="error-message">
          <%= errors %>
        </div>

      <% } %>


      <div class="checkout-layout">


        

        <div class="order-card">

          <div class="card-header">

            <h3>
              Order Items
            </h3>

            <span>
              <%= orderItems.length %> Products
            </span>

          </div>


          <div class="order-items">

            <% orderItems.forEach(item=> { %>

              <div class="order-item">


                <div class="order-item-image">

                  <img
                    src="<%= item.Product.imageURL %>"
                    alt="<%= item.Product.productName %>"
                  />

                </div>


                <div class="order-item-info">

                  <h4>
                    <%= item.Product.productName %>
                  </h4>

                  <p>
                    <%= item.quantity %> ×
                    <%= formatRp(item.priceAtPurchase) %>
                  </p>

                </div>


                <strong class="item-total">

                  <%= formatRp(item.priceAtPurchase * item.quantity) %>

                </strong>

              </div>

            <% }) %>

          </div>

        </div>


        

        <aside class="checkout-summary">


         

          <div class="payment-card">

            <h3>
              Payment Method
            </h3>


            <form action="/checkout" method="POST">


              <label class="payment-option">

                <input
                  type="radio"
                  name="paymentMethod"
                  value="Bank Transfer"
                  
                />

                <div>

                  <strong>
                    Bank Transfer
                  </strong>

                  <span>
                    Transfer pembayaran melalui bank
                  </span>

                </div>

              </label>


              <label class="payment-option">

                <input
                  type="radio"
                  name="paymentMethod"
                  value="Cash"
                />

                <div>

                  <strong>
                    Cash
                  </strong>

                  <span>
                    Pembayaran secara langsung
                  </span>

                </div>

              </label>


              <label class="payment-option">

                <input
                  type="radio"
                  name="paymentMethod"
                  value="E-Wallet"
                />

                <div>

                  <strong>
                    E-Wallet
                  </strong>

                  <span>
                    Pembayaran menggunakan e-wallet
                  </span>

                </div>

              </label>


             

              <div class="summary-divider"></div>


              <div class="summary-row">

                <span>
                  Total Products
                </span>

                <span>
                  <%= formatRp(order.totalAmount - order.totalOngkir) %>
                </span>

              </div>


              <div class="summary-row">

                <span>
                  Total Ongkir
                </span>

                <span>
                  <%= formatRp(order.totalOngkir) %>
                </span>

              </div>


              <div class="summary-divider"></div>


              <div class="summary-row total-row">

                <span>
                  Total Payment
                </span>

                <strong>
                  <%= formatRp(order.totalAmount) %>
                </strong>

              </div>


              <button
                type="submit"
                class="place-order-button"
              >
                Pay
              </button>


            </form>

          </div>


        </aside>

      </div>

    </main>

  </div>

</body>

</html>