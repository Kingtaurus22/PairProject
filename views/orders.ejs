<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>
    <%= title %>
  </title>
</head>

<body>
  <a href="/">← Back to Products</a>

  <h1>My Orders</h1>

  <% if (orders.length===0) { %>

    <p>Belum ada order.</p>

    <% } else { %>

      <% orders.forEach(order=> { %>

        <div>
          <h2>
            Order #<%= order.id %>
          </h2>

          <p>
            Status:
            <%= order.status %>
          </p>

          <p>
            totalOngkir:
            <%= order.totalOngkir %>
          </p>

          <p>
            Payment:
            <%= order.paymentMethod %>
          </p>

          <p>
            Total:
            <%= formatRp(order.totalAmount) %>
          </p>

          <a href="/orders/<%= order.id %>/invoice">Download Invoice</a>

          <h3>Products</h3>

          <% order.Products.forEach(product=> { %>

            <p>
              <%= product.productName %>
                -
                Quantity:
                <%= product.OrderItem.quantity %>
            </p>

            <% }) %>

              <hr />

        </div>

        <% }) %>

          <% } %>

</body>

</html>